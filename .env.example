# =============================================================================
# Schedule Dashboard — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# All variables are server-side only — never exposed to the browser.

# Quip API access token (Bearer auth for Quip Automation API)
QUIP_ACCESS_TOKEN=

# A-Z leave system access token (SSO/Midway authentication)
AZ_ACCESS_TOKEN=

# Amazon Connect instance ID (used by Connect_Tracker)
CONNECT_INSTANCE_ID=

# Amazon Connect report ARN for real-time metrics
CONNECT_REPORT_ARN=
